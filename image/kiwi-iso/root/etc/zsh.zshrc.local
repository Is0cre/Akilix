# Akilix interactive shell baseline. This file is loaded by openSUSE's
# /etc/zshrc after distribution defaults and remains user-overridable.
[[ -o interactive ]] || return

# CLI programs should always have a capable editor, while respecting an
# operator's explicit environment choice.
: ${EDITOR:=vim}
: ${VISUAL:=$EDITOR}
export EDITOR VISUAL

# nnn stays local and uses the configured editor for text and internal edits.
# Type-to-navigate keeps large evidence trees quick to traverse.
: ${NNN_OPTS:=eEn}
: ${NNN_COLORS:=2341}
export NNN_OPTS NNN_COLORS

# Learned directory jumps remain entirely local to the operator account.
if (( $+commands[zoxide] )); then
  eval "$(zoxide init zsh)"
fi

# Load packaged completion functions, including Akilix. compinit only indexes
# functions already installed locally and caches the index in the user's home.
fpath=(/usr/share/zsh/site-functions $fpath)
autoload -Uz compinit
if (( ! $+functions[compdef] )); then
  compinit -d "${ZDOTDIR:-$HOME}/.zcompdump"
fi
autoload -Uz _akilix
compdef _akilix akilix
zstyle ':completion:*' menu select
zstyle ':completion:*' matcher-list 'm:{a-zA-Z}={A-Za-z}'

# Keep substantial, timestamped history and synchronize it between terminals.
# A command beginning with a space is intentionally excluded so operators can
# avoid persisting credentials or other sensitive values.
HISTFILE=${ZDOTDIR:-$HOME}/.zsh_history
HISTSIZE=100000
SAVEHIST=75000
setopt APPEND_HISTORY
setopt EXTENDED_HISTORY
setopt HIST_FCNTL_LOCK
setopt HIST_IGNORE_SPACE
setopt HIST_LEX_WORDS
setopt SHARE_HISTORY
unsetopt HIST_IGNORE_ALL_DUPS
unsetopt HIST_IGNORE_DUPS
unsetopt HIST_SAVE_NO_DUPS

# Search history using the text already typed at the prompt.
autoload -Uz history-search-end
zle -N history-beginning-search-backward-end history-search-end
zle -N history-beginning-search-forward-end history-search-end
bindkey '^[[A' history-beginning-search-backward-end
bindkey '^[[B' history-beginning-search-forward-end

# Compact prompt: identity and location remain visible in every captured log.
setopt PROMPT_SUBST
PROMPT='%F{green}%n@akilix%f %F{blue}%~%f %# '
RPROMPT='%(?..%F{red}exit %?%f)'
