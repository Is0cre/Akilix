# Akilix operator shell
#
# System defaults provide durable history, Akilix completion, searchable arrow
# keys, and the standard prompt. Put personal aliases and overrides below.

bindkey -e

# Useful local defaults that do not execute programs or contact the network.
setopt AUTO_CD
setopt INTERACTIVE_COMMENTS
setopt NO_BEEP

# Example personal overrides:
# alias ll='ls -lah'
# PROMPT='%n@%m %~ %# '
