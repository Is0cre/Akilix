set $mod Mod4
set $term foot
set $menu fuzzel
set $left h
set $down j
set $up k
set $right l

font pango:Noto Sans 10
floating_modifier $mod normal
default_border pixel 2
gaps inner 6
gaps outer 3
smart_gaps on

output * bg /usr/share/backgrounds/akilix/akilix-3840x2160.png fill

exec mako
exec swayidle -w timeout 300 'systemd-run --user --unit=akilix-weathr-screensaver --collect /usr/bin/akilix-weathr-screensaver' resume 'systemctl --user stop akilix-weathr-screensaver.service' timeout 600 'swaylock --color 0b1114' before-sleep 'swaylock --color 0b1114'
exec $term --title "Akilix Workspace"

bar {
    position top
    font pango:Noto Sans 10
    status_command /usr/bin/akilix bar stream
    colors {
        background #0b1114
        statusline #e8e6dd
        separator #4a5358
        focused_workspace #657a3e #657a3e #e8e6dd
        active_workspace #151a1d #151a1d #e8e6dd
        inactive_workspace #151a1d #151a1d #aab1af
        urgent_workspace #b65c5c #b65c5c #e8e6dd
    }
}

bindsym $mod+Return exec $term
bindsym $mod+d exec $menu
# VM consoles and host compositors frequently intercept the Super key.
bindsym Ctrl+Alt+t exec $term
bindsym Alt+F2 exec $menu
bindsym $mod+Shift+n exec featherpad
bindsym $mod+Shift+f exec pcmanfm-qt
bindsym $mod+Shift+b exec foot --title "Akilix System Monitor" btop
bindsym $mod+Shift+o exec foot --title "Akilix File Navigator" nnn
bindsym $mod+Shift+p exec blueman-manager
bindsym $mod+c exec foot --hold --title "Akilix Calendar" cal -3
bindsym $mod+Shift+q kill
bindsym $mod+f fullscreen toggle
bindsym $mod+Shift+space floating toggle
bindsym $mod+space focus mode_toggle

bindsym $mod+$left focus left
bindsym $mod+$down focus down
bindsym $mod+$up focus up
bindsym $mod+$right focus right
bindsym $mod+Left focus left
bindsym $mod+Down focus down
bindsym $mod+Up focus up
bindsym $mod+Right focus right

bindsym $mod+Shift+$left move left
bindsym $mod+Shift+$down move down
bindsym $mod+Shift+$up move up
bindsym $mod+Shift+$right move right

set $ws1 "1"
set $ws2 "2"
set $ws3 "3"
set $ws4 "4"
set $ws5 "5"
set $ws6 "6"
set $ws7 "7"
set $ws8 "8"
set $ws9 "9"

bindsym $mod+1 workspace number $ws1
bindsym $mod+2 workspace number $ws2
bindsym $mod+3 workspace number $ws3
bindsym $mod+4 workspace number $ws4
bindsym $mod+5 workspace number $ws5
bindsym $mod+6 workspace number $ws6
bindsym $mod+7 workspace number $ws7
bindsym $mod+8 workspace number $ws8
bindsym $mod+9 workspace number $ws9
bindsym $mod+Shift+1 move container to workspace number $ws1
bindsym $mod+Shift+2 move container to workspace number $ws2
bindsym $mod+Shift+3 move container to workspace number $ws3
bindsym $mod+Shift+4 move container to workspace number $ws4
bindsym $mod+Shift+5 move container to workspace number $ws5
bindsym $mod+Shift+6 move container to workspace number $ws6
bindsym $mod+Shift+7 move container to workspace number $ws7
bindsym $mod+Shift+8 move container to workspace number $ws8
bindsym $mod+Shift+9 move container to workspace number $ws9

bindsym $mod+b splith
bindsym $mod+v splitv
bindsym $mod+s layout stacking
bindsym $mod+w layout tabbed
bindsym $mod+e layout toggle split
bindsym $mod+a focus parent
bindsym $mod+Shift+c reload
bindsym $mod+Shift+e exec swaynag -t warning -m 'Exit the Akilix session?' -B 'Exit' 'swaymsg exit'
bindsym $mod+Shift+r exec systemd-run --user --unit=akilix-weathr-screensaver --collect /usr/bin/akilix-weathr-screensaver
bindsym $mod+Shift+l exec swaylock --color 0b1114

client.focused #8ead55 #657a3e #e8e6dd #c68a2b #8ead55
client.unfocused #151a1d #151a1d #aab1af #4a5358 #151a1d

include /etc/sway/config.d/*
