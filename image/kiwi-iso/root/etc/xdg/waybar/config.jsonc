{
  "layer": "top",
  "position": "top",
  "height": 30,
  "spacing": 8,
  "modules-left": ["sway/workspaces", "sway/mode"],
  "modules-center": ["clock"],
  "modules-right": ["cpu", "memory", "battery", "tray"],
  "clock": {"format": "{:%Y-%m-%d  %H:%M UTC}", "timezone": "Etc/UTC"},
  "cpu": {"format": "CPU {usage}%"},
  "memory": {"format": "RAM {percentage}%"},
  "battery": {"format": "BAT {capacity}%", "format-charging": "BAT +{capacity}%"}
}
