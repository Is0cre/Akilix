<?xml version="1.0" encoding="utf-8"?>
<image schemaversion="8.0" name="pensuse-m0">
  <description type="system">
    <author>PenSUSE Contributors</author>
    <contact>project maintainers</contact>
    <specification>PenSUSE M0 development image</specification>
  </description>
  <preferences>
    <type image="oem" filesystem="btrfs" format="qcow2"/>
    <version>0.0.1</version>
    <packagemanager>zypper</packagemanager>
    <locale>en_US</locale>
    <keytable>us</keytable>
  </preferences>
  <repository type="rpm-md" alias="openSUSE-Leap-16.0-OSS">
    <source path="https://download.opensuse.org/distribution/leap/16.0/repo/oss/"/>
  </repository>
  <packages type="image">
    <package name="systemd"/>
    <package name="btrfsprogs"/>
    <package name="snapper"/>
    <package name="podman"/>
    <package name="selinux-policy-targeted"/>
    <package name="zsh"/>
    <package name="git"/>
    <package name="iproute2"/>
  </packages>
</image>
