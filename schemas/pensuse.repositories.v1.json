{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "PenSUSE Repository Set v1",
  "type": "object",
  "required": ["schema", "repositories"],
  "properties": {
    "schema": {"const": "pensuse.repositories.v1"},
    "repositories": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["id", "name", "purpose", "tier", "base_url", "key_url", "key_fingerprint", "image_enabled", "status"],
        "properties": {
          "id": {"type": "string", "minLength": 1},
          "name": {"type": "string", "minLength": 1},
          "purpose": {"enum": ["base", "desktop", "boot"]},
          "tier": {"enum": ["release", "obs"]},
          "base_url": {"type": "string", "pattern": "^https://"},
          "key_url": {"type": "string", "pattern": "^https://"},
          "key_fingerprint": {"type": "string", "pattern": "^[0-9A-F]{40}$"},
          "image_enabled": {"type": "boolean"},
          "status": {"enum": ["approved", "candidate"]}
        },
        "additionalProperties": false
      }
    }
  },
  "additionalProperties": false
}
