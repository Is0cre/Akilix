{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://akilix.dev/schemas/akilix.journal.v1.json",
  "title": "Akilix unified workbook journal event",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema", "timestamp", "event", "module", "payload", "provenance_id"],
  "properties": {
    "schema": {"const": "akilix.journal.v1"},
    "timestamp": {"type": "string", "format": "date-time"},
    "event": {"type": "string", "pattern": "^[A-Z][A-Z0-9_]{1,63}$"},
    "module": {"type": "string", "pattern": "^[A-Z][A-Z0-9_-]{1,31}$"},
    "payload": {"type": "object"},
    "provenance_id": {"type": "string", "pattern": "^J-[0-9a-f]{20}$"}
  }
}
