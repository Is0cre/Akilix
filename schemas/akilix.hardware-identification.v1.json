{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://akilix.dev/schemas/akilix.hardware-identification.v1.json",
  "title": "Akilix passive hardware identification",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema", "record_id", "workbook_id", "recorded_at", "device", "inventory_record_id", "passive", "commands", "record_status"],
  "properties": {
    "schema": {"const": "akilix.hardware-identification.v1"},
    "record_id": {"type": "string", "format": "uuid"},
    "workbook_id": {"type": "string", "format": "uuid"},
    "recorded_at": {"type": "string", "format": "date-time"},
    "device": {"$ref": "akilix.hardware-inspection.v1.json#/$defs/device"},
    "inventory_record_id": {"type": "string", "format": "uuid"},
    "passive": {"const": true},
    "commands": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["tool", "args", "exit_code", "status"],
        "properties": {
          "tool": {"enum": ["smartctl", "nvme"]},
          "args": {"type": "array", "items": {"type": "string"}},
          "exit_code": {"type": "integer"},
          "status": {"enum": ["OK", "HEALTH_WARNING", "HEALTH_FAILED", "TOOL_ERROR", "UNAVAILABLE", "INVALID_OUTPUT"]},
          "output": {},
          "error": {"type": "string"}
        }
      }
    },
    "record_status": {"const": "complete"}
  }
}
