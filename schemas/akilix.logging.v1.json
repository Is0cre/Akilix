    "command_arguments": {"type": "boolean"},
    "container_metadata": {"type": "boolean"},
    "evidence_hashing": {"type": "boolean"},
    "stdout_capture": {"type": "boolean"},
    "stderr_capture": {"type": "boolean"},
    "generated_file_tracking": {"type": "boolean"},
    "packet_metadata": {"type": "boolean"},
    "terminal_recording": {"type": "boolean"}
  },
