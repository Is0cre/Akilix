{
  "$schema":"https://json-schema.org/draft/2020-12/schema",
  "title":"PenSUSE RPM Package Lock v1",
  "type":"object",
  "required":["schema","repository_id","architecture","resolved_at","repomd_revision","primary_sha512","packages"],
  "properties":{
    "schema":{"const":"pensuse.package-lock.v1"},
    "repository_id":{"type":"string","minLength":1},
    "architecture":{"const":"x86_64"},
    "resolved_at":{"type":"string","format":"date-time"},
    "repomd_revision":{"type":"string","pattern":"^[0-9]+$"},
    "primary_sha512":{"type":"string","pattern":"^[0-9a-f]{128}$"},
    "packages":{"type":"array","minItems":1,"items":{"type":"object","required":["name","version","sha512","location"],"properties":{"name":{"type":"string"},"version":{"type":"string"},"sha512":{"type":"string","pattern":"^[0-9a-f]{128}$"},"location":{"type":"string","pattern":"^x86_64/"}},"additionalProperties":false}}
  },
  "additionalProperties":false
}
